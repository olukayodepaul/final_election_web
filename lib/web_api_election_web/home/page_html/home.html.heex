    <div class="mt-10 flex justify-between items-center">
      <h1 class="flex items-center text-sm font-semibold leading-6">
        <!-- powered by bimips -->
        <small class="badge badge-warning badge-sm ml-3">
          v{Application.spec(:phoenix, :vsn)}
        </small>
      </h1>
      <Layouts.theme_toggle />
    </div>

      <div class="text-center w-full">
  <h2 class="mt-6 text-3xl sm:text-5xl font-black leading-tight tracking-tight">
    Secure Election
    <span class="text-primary">
      Monitoring
    </span>
    Infrastructure
</h2>
</div>

 <p class="mt-4 leading-7 text-base-content/70">
      A secure, offline-first platform designed for Party Representatives to monitor polling activities, track logistics, and manage ward-level collation with precision. Ensure every vote is accounted for and every incident is addressed instantly
    </p>

    
  <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
  
  <!-- Monitor Login Button -->
  <a
    href={~p"/login_monitor"}
    class="group inline-flex items-center gap-3 rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-content transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
  >
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-content/10">
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="flex flex-col leading-tight">
      <span class="text-[10px] uppercase tracking-wider opacity-70">Monitor Access</span>
      <span class="text-sm font-bold">Monitor Login</span>
    </div>
  </a>

  <!-- Result View Login Button -->
  <a
    href={~p"/login_result"}
    class="group inline-flex items-center gap-3 rounded-xl bg-success px-4 py-3 text-sm font-semibold text-success-content transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
  >
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-success-content/10">
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
        <path d="M15 3H19C20.1 3 21 3.9 21 5V19C21 20.1 20.1 21 19 21H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 17L15 12L10 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="flex flex-col leading-tight">
      <span class="text-[10px] uppercase tracking-wider opacity-70">Secure Access</span>
      <span class="text-sm font-bold">Result View Login</span>
    </div>
  </a>

  <!-- Contact Us for Demo Button -->
  <a
    href={~p"/contact"}
    class="group inline-flex items-center gap-3 rounded-xl bg-base-300 px-4 py-3 text-sm font-semibold text-base-content transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
  >
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-base-content/10">
      <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
        <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="flex flex-col leading-tight">
      <span class="text-[10px] uppercase tracking-wider opacity-70">Get Started</span>
      <span class="text-sm font-bold">Contact Us for Demo</span>
    </div>
  </a>

</div>
    

      <div class="mb-10">
         
          <!-- Features -->
          <div class="mt-12 space-y-6">

            <!-- Item -->
            <div class="flex items-start gap-4">
              <div class="mt-1 flex h-11 w-11 items-center justify-center rounded-xl bg-success/15 text-success">
                <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                  <path
                    d="M20 6L9 17L4 12"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div>
                <h3 class="font-semibold">
                  Offline First Architecture
                </h3>

                <p class="mt-1 text-sm text-base-content/60">
                  Continue field operations even without internet access.
                </p>
              </div>
            </div>

            <!-- Item -->
            <div class="flex items-start gap-4">
              <div class="mt-1 flex h-11 w-11 items-center justify-center rounded-xl bg-info/15 text-info">
                <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                  <path
                    d="M12 8V12L15 15"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                </svg>
              </div>

              <div>
                <h3 class="font-semibold">
                  Real-Time Incident Reporting
                </h3>

                <p class="mt-1 text-sm text-base-content/60">
                  Instantly escalate incidents directly to the situation room.
                </p>
              </div>
            </div>


            

            <!-- Item -->
            <div class="flex items-start gap-4">
              <div class="mt-1 flex h-11 w-11 items-center justify-center rounded-xl bg-warning/15 text-warning">
                <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5">
                  <path
                    d="M12 2L3 7V12C3 17.5 6.8 22.3 12 23C17.2 22.3 21 17.5 21 12V7L12 2Z"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <div>
                <h3 class="font-semibold">
                  Secure Result Management
                </h3>

                <p class="mt-1 text-sm text-base-content/60">
                  Safely upload and manage election result data.
                </p>
              </div>
            </div>

          </div>
        </div>



    <div class="mt-8 flex justify-center">
      <div class="max-w-xs w-full rounded-2xl overflow-hidden shadow-xl border border-base-200">
        <img 
          src={~p"/images/app.jpeg"} 
          alt="Election Monitoring Mobile App" 
          class="w-full h-auto mx-auto" 
        />
      </div>
    </div>



    <div class="w-full">

    

    <div class="flex justify-center mt-10">
      <div class="w-auto text-base-content">
        <a href="https://bimips.com" target="_blank" class="group flex text-sm text justify-between rounded-full pl-4 pr-4 bg-base-200 px-3 py-2 hover:bg-base-100 hover:text-base-content transition">
          <span class="flex items-center gap-3">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="h-4 w-4 fill-base-content/40 group-hover:fill-base-content">
              <path d="M8 13.833c3.866 0 7-2.873 7-6.416C15 3.873 11.866 1 8 1S1 3.873 1 7.417c0 1.081.292 2.1.808 2.995.606 1.05.806 2.399.086 3.375l-.208.283c-.285.386-.01.905.465.85.852-.098 2.048-.318 3.137-.81a3.717 3.717 0 0 1 1.91-.318c.263.027.53.041.802.041Z" />
            </svg>
            Powered by bimips
          </span>
        </a>
      </div>
    </div>


  </div>

   
  </div>
</div>